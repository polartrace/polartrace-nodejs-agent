{
  "name": "polartrace",
  "version": "1.0.12",
  "description": "Production-ready observability agent for Node.js applications with zero-code integration, OpenTelemetry support, and automatic Express/MongoDB instrumentation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"src/**/*.ts\""
  },
  "keywords": [
    "polartrace",
    "observability",
    "monitoring",
    "tracing",
    "opentelemetry",
    "apm",
    "performance",
    "logging",
    "express",
    "mongodb",
    "middleware",
    "instrumentation",
    "analytics",
    "tracking",
    "distributed-tracing",
    "telemetry",
    "profiling"
  ],
  "author": "PolarTrace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/polartrace/polartrace-nodejs-agent.git"
  },
  "bugs": {
    "url": "https://github.com/polartrace/polartrace-nodejs-agent/issues"
  },
  "homepage": "https://www.polartrace.com",
  "peerDependencies": {
    "express": "^4.0.0",
    "mongoose": ">=6"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.45.0",
    "@opentelemetry/instrumentation": "^0.49.1",
    "@opentelemetry/instrumentation-express": "^0.37.0",
    "@opentelemetry/instrumentation-http": "^0.49.1",
    "@opentelemetry/resources": "^1.24.0",
    "@opentelemetry/sdk-node": "^0.49.1",
    "@opentelemetry/sdk-trace-base": "^1.24.0",
    "uuid": "^9.0.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./register": {
      "require": "./dist/register.js",
      "import": "./dist/register.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
